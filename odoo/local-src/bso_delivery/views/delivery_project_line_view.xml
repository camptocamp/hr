<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="delivery_line_form_view" model="ir.ui.view">
        <field name="name">delivery.line.form</field>
        <field name="model">delivery.project.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <notebook>
                        <page string="General">
                            <group>
                                <field name="name"/>
                                <field name="date_forecasted"/>
                                <field name="date_sla"/>
                            </group>
                        </page>
                        <page string="Handover Details">
                            <group>
                                <field name="delivery_date"/>
                                <field name="extra_note"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>