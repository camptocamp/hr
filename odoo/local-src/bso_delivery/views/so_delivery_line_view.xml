<odoo>
    <record id="delivery_line_so_form" model="ir.ui.view">
        <field name="name">delivery_line_so_form</field>
        <field name="model">delivery.line.so</field>
        <field name="inherit_id" ref="bso_delivery.delivery_line_form_view"/>
        <field name="mode">primary</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_sla']" position="after">
                <field name="jira_product_template_ids"
                       widget="many2many_tags"
                       domain="[('template_type', '=', 'sale')]"
                />
            </xpath>
            <xpath expr="//field[@name='delivery_date']" position="before">
                <field name="product_category"/>
                <field name="service_id"/>
                <field name="hosting_site_address"
                       attrs="{'invisible':[('product_category', '!=','hosting')]}"/>
                <field name="rack_location"
                       attrs="{'invisible':[('product_category', '!=','hosting')]}"/>
                <field name="site_address"
                       attrs="{'invisible':[('product_category', 'not in',('iptransit', 'other'))]}"/>
                <field name="demarcation"
                       attrs="{'invisible':[('product_category', '!=','iptransit')]}"/>
                <field name="ip_details"
                       attrs="{'invisible':[('product_category', '!=','iptransit')]}"/>
                <field name="service_details"
                       attrs="{'invisible':[('product_category', '!=','other')]}"/>
                <field name="service_point"
                       attrs="{'invisible':[('product_category', 'not in', ('l2l', 'm2m'))]}">
                    <tree editable="bottom">
                        <field name="point_name" readonly="1"/>
                        <field name="site_address"/>
                        <field name="demarcation"/>
                        <field name="handoff"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>
    <record id="delivery_line_so_tree_view" model="ir.ui.view">
        <field name="name">delivery.line.so.tree.view</field>
        <field name="model">delivery.line.so</field>
        <field name="arch" type="xml">
            <tree>
                <field name="delivery_id"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="date_forecasted"/>
                <field name="date_sla"/>
                <field name="delivery_date"/>
            </tree>
        </field>
    </record>
    <record id="delivery_line_so_form_view" model="ir.ui.view">
        <field name="name">delivery.line.so.form.view</field>
        <field name="model">delivery.line.so</field>
        <field name="priority" eval="15"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="delivery_id"/>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="date_forecasted"/>
                        <field name="date_sla"/>
                        <field name="delivery_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>